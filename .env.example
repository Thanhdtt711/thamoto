# ============================================================================
# CLIENT-SIDE (Public — chỉ dùng URL và Anon Key, KHÔNG đặt service_role ở đây)
# ============================================================================
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Legacy Vite (giữ tương thích nếu cần chạy thư mục src/ cũ)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ============================================================================
# SERVER-SIDE / SUPABASE EDGE FUNCTIONS ONLY (cấu hình bằng `supabase secrets set`)
# TUYỆT ĐỐI KHÔNG đưa giá trị thật vào repo hoặc biến NUXT_PUBLIC_*
# ============================================================================
# SUPABASE_SERVICE_ROLE_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFY_WEBHOOK_SECRET=
# RESEND_API_KEY=
# ORDER_NOTIFY_EMAIL=
